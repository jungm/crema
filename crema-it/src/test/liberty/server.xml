<?xml version="1.0" encoding="UTF-8"?>
<server description="Crema integration tests">
    <featureManager>
        <feature>webProfile-10.0</feature>
        <feature>mpConfig-3.1</feature>
        <feature>mpJwt-2.1</feature>
        <feature>localConnector-1.0</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint" host="localhost"
                  httpPort="${liberty.http.port}" httpsPort="${liberty.https.port}"/>

    <keyStore id="defaultKeyStore" password="crema-it-keystore"/>
