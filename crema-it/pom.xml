<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.jungm</groupId>
        <artifactId>crema-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>crema-it</artifactId>
    <name>Crema Integration Tests</name>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>

        <arquillian.version>1.10.2.Final</arquillian.version>
        <shrinkwrap.version>1.2.6</shrinkwrap.version>
        <json-schema-validator.version>1.5.9</json-schema-validator.version>
        <conformance.version>0.2.0-alpha.11</conformance.version>

        <tomee.version>10.2.0</tomee.version>
        <tomee.classifier>microprofile</tomee.classifier>
        <wildfly.version>41.0.1.Final</wildfly.version>
        <wildfly-arquillian.version>5.1.0.Final</wildfly-arquillian.version>
        <openliberty.version>26.0.0.9</openliberty.version>
        <liberty-arquillian.version>3.0.0</liberty-arquillian.version>
        <payara.version>6.2025.11</payara.version>
        <payara-arquillian.version>3.1</payara-arquillian.version>

        <!-- Non-default ports, distinct per Runtime, so profiles don't clash with each other or with local servers. -->
        <it.tomee.http.port>18080</it.tomee.http.port>
        <it.tomee.stop.port>18005</it.tomee.stop.port>
        <it.wildfly.port.offset>10100</it.wildfly.port.offset>
        <it.wildfly.management.port>20090</it.wildfly.management.port>
        <it.payara.admin.port>4848</it.payara.admin.port>
        <it.openliberty.http.port>18280</it.openliberty.http.port>
        <it.openliberty.https.port>18643</it.openliberty.https.port>

        <!-- Set by the Runtime profiles; without a profile the integration tests are skipped. -->
        <skipITs>true</skipITs>
        <it.runtime>none</it.runtime>
        <liberty.dir>${project.build.directory}/liberty</liberty.dir>
        <!-- The Liberty adapter refuses to start while any JVM runs a Liberty server of the same name. -->
        <it.liberty.server>crema-it</it.liberty.server>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jboss.arquillian</groupId>
                <artifactId>arquillian-bom</artifactId>
                <version>${arquillian.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.jungm</groupId>
            <artifactId>crema</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The fake Authorization Server of the security tests. -->
        <dependency>
            <groupId>io.github.jungm</groupId>
            <artifactId>crema</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-web-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JSON-P for the MCP test client, and a JSON Schema 2020-12 validator for the wire schema checks. -->
        <dependency>
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.arquillian.junit5</groupId>
            <artifactId>arquillian-junit5-container</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-api</artifactId>
            <version>${shrinkwrap.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.shrinkwrap</groupId>
            <artifactId>shrinkwrap-impl-base</artifactId>
            <version>${shrinkwrap.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <skipITs>${skipITs}</skipITs>
                    <systemPropertyVariables>
                        <arquillian.launch>${it.runtime}</arquillian.launch>
                        <crema.it.runtime>${it.runtime}</crema.it.runtime>
                        <crema.it.findings.dir>${project.build.directory}/findings</crema.it.findings.dir>
                        <!-- Lets the MCP test client send a Host header for the DNS rebinding tests. -->
                        <jdk.httpclient.allowRestrictedHeaders>host</jdk.httpclient.allowRestrictedHeaders>
                        <crema.it.conformance.version>${conformance.version}</crema.it.conformance.version>
                        <crema.it.conformance.baseline>${project.basedir}/src/test/conformance/baseline-2026-07-28.yml</crema.it.conformance.baseline>
                        <crema.it.conformance.output>${project.build.directory}/conformance</crema.it.conformance.output>
                        <it.tomee.http.port>${it.tomee.http.port}</it.tomee.http.port>
                        <it.tomee.stop.port>${it.tomee.stop.port}</it.tomee.stop.port>
                        <it.tomee.dir>${project.build.directory}/tomee</it.tomee.dir>
                        <it.tomee.version>${tomee.version}</it.tomee.version>
                        <it.tomee.classifier>${tomee.classifier}</it.tomee.classifier>
                        <it.payara.home>${project.build.directory}/payara6</it.payara.home>
                        <it.payara.admin.port>${it.payara.admin.port}</it.payara.admin.port>
                        <it.wildfly.home>${project.build.directory}/wildfly-${wildfly.version}</it.wildfly.home>
                        <it.wildfly.port.offset>${it.wildfly.port.offset}</it.wildfly.port.offset>
                        <it.wildfly.management.port>${it.wildfly.management.port}</it.wildfly.management.port>
                        <it.liberty.home>${liberty.dir}/wlp</it.liberty.home>
                        <it.liberty.server>${it.liberty.server}</it.liberty.server>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>tomee</id>
            <properties>
                <skipITs>false</skipITs>
                <it.runtime>tomee</it.runtime>
            </properties>
            <dependencies>
                <!-- Resolves and unpacks apache-tomee:${tomee.version}:zip:${tomee.classifier} through Maven. -->
                <dependency>
                    <groupId>org.apache.tomee</groupId>
                    <artifactId>arquillian-tomee-remote</artifactId>
                    <version>${tomee.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>wildfly</id>
            <properties>
                <skipITs>false</skipITs>
                <it.runtime>wildfly</it.runtime>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.wildfly.arquillian</groupId>
                    <artifactId>wildfly-arquillian-container-managed</artifactId>
                    <version>${wildfly-arquillian.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>unpack-wildfly</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>unpack</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>org.wildfly</groupId>
                                            <artifactId>wildfly-dist</artifactId>
                                            <version>${wildfly.version}</version>
                                            <type>zip</type>
                                            <outputDirectory>${project.build.directory}</outputDirectory>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>openliberty</id>
            <properties>
                <skipITs>false</skipITs>
                <it.runtime>openliberty</it.runtime>
                <liberty.groupId>io.openliberty</liberty.groupId>
                <liberty.artifactId>openliberty-runtime</liberty.artifactId>
                <liberty.version>${openliberty.version}</liberty.version>
                <liberty.http.port>${it.openliberty.http.port}</liberty.http.port>
                <liberty.https.port>${it.openliberty.https.port}</liberty.https.port>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.openliberty.arquillian</groupId>
                    <artifactId>arquillian-liberty-managed-jakarta</artifactId>
                    <version>${liberty-arquillian.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>unpack-liberty</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>unpack</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>${liberty.groupId}</groupId>
                                            <artifactId>${liberty.artifactId}</artifactId>
                                            <version>${liberty.version}</version>
                                            <type>zip</type>
                                            <outputDirectory>${liberty.dir}</outputDirectory>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>liberty-server-config</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${liberty.dir}/wlp/usr/servers/${it.liberty.server}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>src/test/liberty</directory>
                                            <filtering>true</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <it.liberty.http.port>${liberty.http.port}</it.liberty.http.port>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>payara</id>
            <properties>
                <skipITs>false</skipITs>
                <it.runtime>payara</it.runtime>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>fish.payara.arquillian</groupId>
                    <artifactId>arquillian-payara-server-managed</artifactId>
                    <version>${payara-arquillian.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>unpack-payara</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>unpack</goal>
                                </goals>
                                <configuration>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>fish.payara.distributions</groupId>
                                            <artifactId>payara</artifactId>
                                            <version>${payara.version}</version>
                                            <type>zip</type>
                                            <outputDirectory>${project.build.directory}</outputDirectory>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
